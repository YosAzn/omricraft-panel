rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // OmriCraft shared servers — כל משתמש מאומת (כולל אנונימי) יכול לקרוא ולכתוב
    match /omricraft/main/servers/{serverId} {
      allow read, write: if request.auth != null;
    }

    // Custom addons
    match /omricraft/main/customAddons/{addonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Admin config — כל משתמש מאומת יכול לקרוא; כתיבה רק ראשונה (אם לא קיים)
    match /omricraft/main/config/admin {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
    }

    // כל שאר הנתיבים — חסום
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
