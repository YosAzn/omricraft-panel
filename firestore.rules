rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // OmriCraft servers — read: owner או אדמין; write: אדמין בלבד.
    // ADMIN_EMAILS מסונכרן עם functions/index.js + src/App.jsx (3 עותקים — rules לא יכול import).
    // הערה: legacy servers בלי ownerUid ייקראו רק ע"י אדמין (תקין — יוסף רואה הכל).
    match /omricraft/main/servers/{serverId} {
      allow read: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid
            || request.auth.token.email in ['yosijo@gmail.com', 'omri.sokolov@gmail.com']);
      allow write: if request.auth != null
        && request.auth.token.email in ['yosijo@gmail.com', 'omri.sokolov@gmail.com'];
    }

    // Custom addons — read: כל מאומת; write: אדמין בלבד.
    // (אחרת כל אנונימי יכול להשחית/להזריק payload לקטלוג שמוצג ב-UI.)
    match /omricraft/main/customAddons/{addonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email in ['yosijo@gmail.com', 'omri.sokolov@gmail.com'];
    }

    // War Room dismissals — issueKeys שהוסתרו ידנית לכל שרת (doc id = serverId).
    // הכתיבה נעשית רק דרך callable dismissDiagnostic (admin SDK, עוקף rules); הפילטור
    // ב-getDiagnostics (admin SDK) — הלקוח לא קורא כאן ישירות. הכללים כאן הם הגנה:
    // קריאה = owner של השרת או אדמין; כתיבה ישירה מהלקוח חסומה (רק ה-callable כותב).
    match /omricraft/main/dismissedDiagnostics/{serverId} {
      allow read: if request.auth != null
        && (get(/databases/$(database)/documents/omricraft/main/servers/$(serverId)).data.ownerUid == request.auth.uid
            || request.auth.token.email in ['yosijo@gmail.com', 'omri.sokolov@gmail.com']);
      allow write: if false;
    }

    // Admin config — קריאה לכל מאומת; כתיבה חסומה לחלוטין (anti-admin-hijack).
    // ה-doc כבר קיים (adminUid נקבע בכניסה הראשונה); אין צורך ב-create יותר,
    // וחסימתו מונעת מתוקף אנונימי לחטוף אדמין. שינוי adminUid = ידנית בקונסולה.
    match /omricraft/main/config/admin {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // כל שאר הנתיבים — חסום
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
